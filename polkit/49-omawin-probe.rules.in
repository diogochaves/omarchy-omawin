// Omawin: throwaway probe rule for @USER@. It checks by BEHAVIOUR, not by
// logging (polkitd runs with --log-level=notice on Omarchy and polkit.log()
// lines never reach the journal there), that pkexec's action details are what
// 49-omawin.rules matches on. So this rule allows exactly ONE harmless,
// read-only command line — `__priv status`, which only runs `docker inspect`
// — to @USER@ only, and only when both details pkexec supplies, "program" and
// "command_line", match the resolved path plus arguments the real rule will
// match on. Nothing else is granted; every other pkexec call prompts as usual.
//
//   sudo ./setup polkit --probe
//   pkexec /usr/bin/omarchy-windows-vm __priv status         no prompt = the
//                                                            details are as
//                                                            expected
//   pkexec /usr/bin/omarchy-windows-vm __priv status extra   must still prompt
//                                                            (cancel it)
//
// A prompt on the first call means "program" or "command_line" hold something
// else, and 49-omawin.rules must not be installed as written.
//
// IT MUST NOT STAY INSTALLED — not because it grants much (status is what the
// unprivileged sampler already knows) but because it is a test, not the rule.
// `sudo ./setup polkit` removes it (so does --remove).
polkit.addRule(function (action, subject) {
  if (action.id !== "org.freedesktop.policykit.exec") return;
  if (subject.user !== "@USER@") return;
  if (action.lookup("program") !== "/usr/bin/omarchy-windows-vm") return;
  if (action.lookup("command_line") !== "/usr/bin/omarchy-windows-vm __priv status") return;
  return polkit.Result.YES;
});
