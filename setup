#!/bin/bash
# Installs chaves.omawin's two optional privileged parts: the polkit rule and
# the clean-shutdown unit.
#
#   sudo ./setup polkit [--user NAME]   show the rendered 49-omawin.rules for
#                                       NAME (default $SUDO_USER), ask, and
#                                       install it; also removes the probe
#                                       rule. Idempotent. --yes skips the
#                                       question.
#   sudo ./setup polkit --probe         same, for the throwaway probe rule
#                                       that allows one read-only command
#                                       line, to check what 49-omawin.rules
#                                       has to match on this box
#   sudo ./setup polkit --status        which of the two rules are installed
#   sudo ./setup polkit --remove        remove both
#   sudo ./setup shutdown               show omawin-vm-shutdown.service, ask,
#                                       install and enable it. Idempotent.
#                                       --yes skips the question.
#   sudo ./setup shutdown --status      whether it is installed and enabled
#   sudo ./setup shutdown --remove      disable and remove it
#   ./setup -h                          this text
#
# Both rules are shown in full before anything is written, so what root
# installs is what was read on screen, not whatever a file in the checkout
# holds at that moment.
#
# For the rule, root is needed only because /etc/polkit-1/rules.d is
# root:polkitd 0750: the rules cannot even be listed as the user. Nothing is
# started or stopped, and the VM is never touched.
#
# The unit goes to /etc/systemd/system, enabled as wanted by docker.service,
# and is started (its start does nothing) if Docker runs. It is ordered after
# docker.service, so systemd stops it first: its stop resumes a paused VM and
# stops it with `docker stop -t 120`, before Omarchy's 5 s limit can kill
# it with Docker. Removing it never stops it: that would shut Windows down. It
# stays armed until the next reboot, which is harmless. Unlike the rules
# directory, /etc/systemd/system is world-readable, so the widget asks
# `systemctl is-enabled` and needs no copy.
#
# polkitd watches the rules directory and reloads on its own (inotify), so no
# daemon is restarted here — the rule is live the moment install(1) returns.
#
# Installing also drops a user-owned copy of the installed rule at
# ~/.local/state/omawin/49-omawin.rules (0644, chowned to the target user), and
# --remove deletes it. That copy is the only way the widget can know the rule is
# there: /etc/polkit-1/rules.d is root:polkitd 0750, so the user cannot list it
# or even test -f a file in it, and pkcheck --detail refuses an unprivileged
# caller. The copy is byte for byte what was installed, so the Settings card can
# show the real thing; its mtime is when it was installed. It is a record, not
# the truth — a rule taken out by hand leaves the copy behind.
#
# The copy goes to the target user's ~/.local/state, not to $XDG_STATE_HOME:
# root cannot read the user's environment. helpers/rule-state.sh looks at
# $XDG_STATE_HOME/omawin first and falls back to ~/.local/state/omawin, so a
# user who moved their state directory is covered.
#
# Everything is resolved from $0, so `sudo ./setup polkit` works from the
# checkout without a PATH or an installed copy. coreutils and bash only.
#
# Test hooks (for tests/setup.test.mjs; never set them by hand):
#   POLKIT_RULES_DIR      rules directory  (default /etc/polkit-1/rules.d)
#   SETUP_SKIP_ROOT_CHECK =1 skips the "must be root" guard, so the tests can
#                         install into a fake root as an ordinary user. The
#                         -o root -g root of install(1) is likewise only
#                         passed when actually running as root.
#   OMAWIN_STATE_DIR      where the user-owned copy goes (default the target
#                         user's ~/.local/state/omawin)
#   SETUP_TARGET_HOME     that user's home, when getent should not be asked
#   SYSTEMD_UNIT_DIR      unit directory   (default /etc/systemd/system)
#   SETUP_SYSTEMCTL       systemctl to run (default /usr/bin/systemctl)

set -euo pipefail
export LC_ALL=C

repo_dir=$(cd -- "$(dirname -- "$0")" && pwd)
rules_dir=${POLKIT_RULES_DIR:-/etc/polkit-1/rules.d}

rule_name=49-omawin.rules
probe_name=49-omawin-probe.rules
rule_src=$repo_dir/polkit/49-omawin.rules.in
probe_src=$repo_dir/polkit/49-omawin-probe.rules.in
rule_dest=$rules_dir/$rule_name
probe_dest=$rules_dir/$probe_name

unit_dir=${SYSTEMD_UNIT_DIR:-/etc/systemd/system}
unit_name=omawin-vm-shutdown.service
unit_src=$repo_dir/systemd/$unit_name
unit_dest=$unit_dir/$unit_name
systemctl=${SETUP_SYSTEMCTL:-/usr/bin/systemctl}

usage() {
  sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'
}

die() {
  echo "setup: $*" >&2
  exit 1
}

require_root() {
  [[ ${SETUP_SKIP_ROOT_CHECK-} == 1 ]] && return 0
  ((EUID == 0)) || die "must be run as root: sudo ./setup $*"
}

# install(1) cannot chown as a non-root user, and the tests run as one.
install_file() {
  local src=$1 dest=$2
  local -a owner=()
  ((EUID == 0)) && owner=(-o root -g root)
  install -D -m 0644 "${owner[@]}" "$src" "$dest"
}

remove_file() {
  local path=$1
  [[ -e $path ]] || return 1
  rm -f "$path"
}

# Where the user-owned copy of the rule lives: $OMAWIN_STATE_DIR if the tests
# set it, otherwise the target user's ~/.local/state/omawin. Fails (empty) when
# there is no user to ask about, which is only possible under --remove and
# --status with no $SUDO_USER and no --user.
state_dir() {
  local user=$1 home=${SETUP_TARGET_HOME-}
  if [[ -n ${OMAWIN_STATE_DIR-} ]]; then
    printf '%s\n' "$OMAWIN_STATE_DIR"
    return 0
  fi
  if [[ -z $home ]]; then
    [[ -n $user ]] || return 1
    home=$(getent passwd -- "$user" 2>/dev/null | cut -d: -f6) || return 1
  fi
  [[ $home == /* ]] || return 1
  printf '%s/.local/state/omawin\n' "$home"
}

# Runs a command as the target user when this script is root. Everything under
# the user's home is touched this way: as root, install(1) and rm(1) would
# follow a symlink planted at ~/.local/state/omawin (or above it) and chown,
# chmod or delete whatever it points at. As the user, a link like that only
# reaches what the user could already write.
as_user() {
  local user=$1
  shift
  if ((EUID == 0)) && [[ -n $user ]]; then
    /usr/bin/setpriv --reuid="$user" --regid="$(id -g -- "$user")" --init-groups -- "$@"
  else
    "$@"
  fi
}

# The copy is made FROM the installed file, so it is byte for byte what polkitd
# reads — not a second rendering of the template that could drift from it.
# Root opens the rule (rules.d is root:polkitd 0750) and hands it over on
# stdin; the user writes it.
record_rule() {
  local user=$1 dir file
  dir=$(state_dir "$user") || {
    echo "setup: warning: no home for '$user': the widget's Settings switch will read as off" >&2
    return 1
  }
  file=$dir/$rule_name
  as_user "$user" install -d -m 0700 -- "$dir" || return 1
  as_user "$user" install -m 0644 -- /dev/stdin "$file" <"$rule_dest" || return 1
  printf '%s\n' "$file"
}

# The user named by an installed rule, read back out of the rule itself.
rule_user() {
  sed -n 's/.*subject\.user !== "\([^"]*\)".*/\1/p' "$1" | head -n 1
}

# $SUDO_USER is empty under plain `su` and says "root" under `sudo -u root`:
# in both cases there is no desktop user to name, so ask for one.
check_user() {
  local user=$1
  [[ -n $user ]] || die "no target user: pass --user NAME"
  [[ $user != root ]] ||
    die "refusing to write a rule for root, which needs no pkexec exemption:
    pass --user NAME"
  [[ $user =~ ^[a-z_][a-z0-9_-]*\$?$ ]] ||
    die "not a plausible user name: $user"
  id -- "$user" >/dev/null 2>&1 ||
    echo "setup: warning: no user '$user' on this system — installing anyway" >&2
}

# Renders $1 for the user, prints it in full, asks, installs it at $2. What is
# installed is the rendered copy that was just shown, never the checkout file.
render_and_install() {
  local src=$1 dest=$2 user=$3
  local tmp
  tmp=$(mktemp)
  # shellcheck disable=SC2064  # $tmp is wanted now, not at trap time
  trap "rm -f '$tmp'" EXIT
  sed "s/@USER@/$user/g" "$src" >"$tmp"
  if grep -q '@USER@' "$tmp"; then die "@USER@ survived substitution"; fi

  echo "About to install this file, as root, at $dest:"
  echo
  sed 's/^/    /' "$tmp"
  echo
  if ((assume_yes)); then
    :
  elif [[ -t 0 ]]; then
    local answer
    read -r -p "Install it? [y/N] " answer
    [[ $answer == [yY] || $answer == [yY][eE][sS] ]] || die "not installed"
  else
    die "no terminal to ask on: re-run with --yes after reading the rule above"
  fi
  install_file "$tmp" "$dest"
  rm -f "$tmp"
  trap - EXIT
}

polkit_install() {
  local user=$1
  check_user "$user"
  render_and_install "$rule_src" "$rule_dest" "$user"

  echo "installed $rule_dest for user $user"
  local copy
  if copy=$(record_rule "$user"); then
    echo "recorded  $copy (a user-owned copy, so the widget can show the switch)"
  fi
  if remove_file "$probe_dest"; then echo "removed   $probe_dest (the probe rule)"; fi
  cat <<EOF

polkitd reloads the directory by itself; the rule is already live. Verify it
as $user, from a terminal:

  pkexec /usr/bin/omarchy-windows-vm __priv status
      must print the docker state (or nothing) with NO dialog

  pkexec /usr/bin/omarchy-windows-vm __priv write_compose </dev/null
      must STILL prompt — cancel it
EOF
}

polkit_probe() {
  local user=$1
  check_user "$user"
  render_and_install "$probe_src" "$probe_dest" "$user"
  cat <<EOF
installed $probe_dest for user $user

It allows exactly one read-only command line, \`__priv status\`, to $user only,
and only when pkexec's "program" and "command_line" details match the resolved
path plus arguments that 49-omawin.rules will match on. Next, as $user:

  pkexec /usr/bin/omarchy-windows-vm __priv status
      must run with NO dialog: the details are what the real rule expects

  pkexec /usr/bin/omarchy-windows-vm __priv status extra
      must STILL prompt — cancel it

  sudo ./setup polkit
      install the real rule (this also removes the probe)
EOF
}

polkit_status() {
  local user=$1 dir copy=
  if dir=$(state_dir "$user"); then copy=$dir/$rule_name; fi
  if [[ -f $rule_dest ]]; then
    echo "present $rule_dest (user: $(rule_user "$rule_dest"))"
  else
    echo "absent  $rule_dest"
  fi
  if [[ -f $probe_dest ]]; then
    echo "present $probe_dest (user: $(rule_user "$probe_dest")) — the probe rule, remove it: sudo ./setup polkit --remove"
  else
    echo "absent  $probe_dest"
  fi
  if [[ -z $copy ]]; then
    echo "unknown the user-owned copy: no target user (pass --user NAME)"
  elif [[ -f $copy ]]; then
    echo "present $copy (user: $(rule_user "$copy")) — what the widget reads"
  else
    echo "absent  $copy — the widget's Settings switch reads as off"
  fi
}

polkit_remove() {
  local user=$1 removed=0 dir
  if remove_file "$rule_dest"; then
    echo "removed $rule_dest"
    removed=1
  fi
  if remove_file "$probe_dest"; then
    echo "removed $probe_dest"
    removed=1
  fi
  # The widget's switch is the copy, so it goes too — even when the rule itself
  # was already gone, which is exactly the stale record the card warns about.
  if dir=$(state_dir "$user") && [[ -e $dir/$rule_name ]] &&
    as_user "$user" rm -f -- "$dir/$rule_name"; then
    echo "removed $dir/$rule_name (the widget's copy)"
    removed=1
  fi
  ((removed)) || echo "nothing to remove: neither rule is installed in $rules_dir"
}

# The unit, shown in full and asked about the way the rule is; it has no
# placeholder, so what is installed is that same file.
shutdown_install() {
  echo "About to install this file, as root, at $unit_dest:"
  echo
  sed 's/^/    /' "$unit_src"
  echo
  if ((assume_yes)); then
    :
  elif [[ -t 0 ]]; then
    local answer
    read -r -p "Install and enable it? [y/N] " answer
    [[ $answer == [yY] || $answer == [yY][eE][sS] ]] || die "not installed"
  else
    die "no terminal to ask on: re-run with --yes after reading the unit above"
  fi
  install_file "$unit_src" "$unit_dest"
  "$systemctl" daemon-reload
  "$systemctl" enable "$unit_name"
  # Its start runs /usr/bin/true: armed now, without waiting for a reboot.
  if "$systemctl" -q is-active docker.service; then "$systemctl" start "$unit_name"; fi
  cat <<EOF
installed $unit_dest, enabled for docker.service

From now on a reboot or power-off waits for Windows to shut down (up to
2 minutes), and wakes a paused VM first. Check it:

  systemctl status $unit_name
EOF
}

shutdown_status() {
  if [[ -f $unit_dest ]]; then
    echo "present $unit_dest ($("$systemctl" is-enabled "$unit_name" 2>/dev/null || echo disabled), $("$systemctl" is-active "$unit_name" 2>/dev/null || echo inactive))"
  else
    echo "absent  $unit_dest"
  fi
}

# Disabled and deleted, never stopped: its stop shuts Windows down.
shutdown_remove() {
  if [[ ! -e $unit_dest ]]; then
    echo "nothing to remove: $unit_dest is not installed"
    return 0
  fi
  "$systemctl" disable "$unit_name" || true
  rm -f "$unit_dest"
  "$systemctl" daemon-reload
  echo "removed $unit_dest (still armed until the next reboot, which only shuts Windows down cleanly once more)"
}

main() {
  local command=${1-}
  [[ -n $command ]] || { usage >&2; exit 2; }
  shift
  case $command in
    -h | --help) usage; exit 0 ;;
    polkit | shutdown) ;;
    *) die "unknown command: $command (try ./setup -h)" ;;
  esac

  local mode=install user=${SUDO_USER-}
  assume_yes=0
  while (($#)); do
    case $1 in
      --remove) mode=remove ;;
      --probe) mode=probe ;;
      --status) mode=status ;;
      --yes | -y) assume_yes=1 ;;
      --user)
        (($# >= 2)) || die "--user needs a name"
        user=$2
        shift
        ;;
      --user=*) user=${1#*=} ;;
      -h | --help) usage; exit 0 ;;
      *) die "unknown option: $1 (try ./setup -h)" ;;
    esac
    shift
  done

  require_root "$command"
  if [[ $command == shutdown ]]; then
    case $mode in
      install) shutdown_install ;;
      status) shutdown_status ;;
      remove) shutdown_remove ;;
      *) die "shutdown takes --status, --remove or --yes" ;;
    esac
    return
  fi
  case $mode in
    install) polkit_install "$user" ;;
    probe) polkit_probe "$user" ;;
    status) polkit_status "$user" ;;
    remove) polkit_remove "$user" ;;
  esac
}

main "$@"
